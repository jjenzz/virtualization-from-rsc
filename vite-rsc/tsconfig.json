{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "@vitejs/plugin-rsc/types"
    ],
    "paths": {
      "@/*": [
        "../*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
